
/* GENERAL SETTINGS */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f0f4ff;
    color: #1e293b;
}

/* NAVIGATION BAR */
nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 8%;
    background-color: #ffffff;
}

nav h2 {
    color: #2563eb;
}

nav a {
    text-decoration: none;
    color: #334155;
    margin-left: 25px;
    font-weight: bold;
}

nav a:hover {
    color: #2563eb;
}

/* HERO SECTION */
.hero {
    height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 20px;
}

.hero h1 {
    font-size: 60px;
    color: #1d4ed8;
    margin-bottom: 15px;
}

.hero p {
    font-size: 18px;
    color: #64748b;
    margin-bottom: 30px;
}

/* BUTTON */
button {
    background-color: #2563eb;
    color: white;
    border: none;
    padding: 15px 30px;
    border-radius: 30px;
    font-size: 16px;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background-color: #1e40af;
    transform: scale(1.05);
}
